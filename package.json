{
    "name": "flo-boolean",
    "sideEffects": false,
    "description": "Boolean operations on planar algebraic curves (currently only simplification is supported).",
    "version": "6.0.1",
    "author": {
        "name": "Floris Steenkamp"
    },
    "private": false,
    "license": "MIT",
    "type": "module",
    "main": "./node/index.js",
    "exports": "./node/index.js",
    "engines": {
        "node": "^12.20.0 || ^14.13.1 || >=16.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FlorisSteenkamp/FloBoolean.git"
    },
    "dependencies": {
        "big-float-ts": "^4.0.4",
        "double-double": "^3.0.4",
        "flo-bezier3": "^8.0.14",
        "flo-draw": "^2.0.5",
        "flo-gauss-quadrature": "^2.1.4",
        "flo-memoize": "^2.0.1",
        "flo-poly": "^8.1.4",
        "flo-vector2d": "^4.0.6"
    },
    "devDependencies": {
        "@jest/globals": "^30.5.0",
        "@swc/core": "^1.16.1",
        "@swc/jest": "^0.2.39",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.4.0",
        "c8": "^12.0.0",
        "canvas": "^3.2.3",
        "circular-dependency-plugin": "^5.2.2",
        "jest": "^30.5.0",
        "jest-environment-jsdom": "^30.5.0",
        "jest-silent-reporter": "^0.6.0",
        "jest-ts-webcompat-resolver": "^1.0.1",
        "rimraf": "^6.1.3",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "webpack": "^5.110.2",
        "webpack-bundle-analyzer": "^5.3.2",
        "webpack-cli": "^7.2.3",
        "squares-rng": "^2.0.4"
    },
    "scripts": {
        "build": "npm run build-browser && npm run build-node",
        "build-node": "rimraf node && tsc",
        "build-browser": "rimraf browser && webpack",
        "test": "jest",
        "test-package": "npm pack"
    },
    "allowScripts": {
        "canvas@3.2.3": true,
        "@parcel/watcher@2.6.0": true,
        "@swc/core@1.16.1": true,
        "unrs-resolver@1.12.2": true
